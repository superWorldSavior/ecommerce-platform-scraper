# Endpoint compatible OpenAI. Aucune valeur par défaut : à renseigner
# explicitement pour éviter d'envoyer des requêtes vers un service non choisi.
# Exemples : http://localhost:11434/v1 (runtime local), ou l'URL de votre
# passerelle / fournisseur.
LLM_BASE_URL=

# Clé du fournisseur. Une valeur factice convient pour un serveur local sans
# authentification.
LLM_API_KEY=

# Modèle texte, et modèle vision utilisé uniquement quand une image est fournie.
# Séparés pour qu'un changement de l'un n'affecte pas l'autre.
LLM_MODEL=
LLM_VISION_MODEL=

# Délai maximal par requête, en millisecondes. Défaut 180000.
LLM_REQUEST_TIMEOUT_MS=
