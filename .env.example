# ─── Model access ────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint works, local or hosted. Four variables are
# required; a missing one fails at startup rather than mid-run.

# Root of the OpenAI-compatible API. No default on purpose: a silent fallback
# could send your data to a provider you never chose.
#
#   local runtime      http://localhost:11434/v1
#   local server       http://localhost:8000/v1
#   hosted provider    https://api.your-provider.example/v1
LLM_BASE_URL=

# Provider key. A dummy value is fine for a local server with no auth.
LLM_API_KEY=

# Text model, and the vision model used only when an image is supplied.
# Kept separate so changing one cannot affect the other: a vision swap should
# not silently alter text extraction, and the reverse.
LLM_MODEL=
LLM_VISION_MODEL=

# ─── Optional ────────────────────────────────────────────────────────────────

# Per-request timeout in milliseconds. Defaults to 180000. Raise it for long
# transcriptions, which take far longer than a structured extraction.
LLM_REQUEST_TIMEOUT_MS=
